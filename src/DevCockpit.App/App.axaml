<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DevCockpit.App.App"
             xmlns:local="using:DevCockpit.App"
             RequestedThemeVariant="Default">
             <!-- El tema real lo elige Configuración (Sistema, Claro u Oscuro); ver App.ApplyTheme. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <!--
      Paleta: neutros fríos de pizarra y un único acento azul tinta. Cada color tiene su versión
      clara y oscura; las vistas usan siempre los nombres Cockpit*, nunca colores sueltos.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CockpitWindow" Color="#F3F5F8" />
                    <SolidColorBrush x:Key="CockpitRail" Color="#E7EBF0" />
                    <SolidColorBrush x:Key="CockpitSurface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CockpitHover" Color="#DCE2E9" />
                    <SolidColorBrush x:Key="CockpitSelected" Color="#D9E5FB" />
                    <SolidColorBrush x:Key="CockpitInk" Color="#1B2027" />
                    <SolidColorBrush x:Key="CockpitMuted" Color="#56606C" />
                    <SolidColorBrush x:Key="CockpitLine" Color="#C6CED8" />
                    <SolidColorBrush x:Key="CockpitAccent" Color="#2F6FDE" />
                    <SolidColorBrush x:Key="CockpitWarning" Color="#26D98E04" />
                    <SolidColorBrush x:Key="CockpitWarningLine" Color="#B07400" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CockpitWindow" Color="#16191E" />
                    <SolidColorBrush x:Key="CockpitRail" Color="#101317" />
                    <SolidColorBrush x:Key="CockpitSurface" Color="#1E232A" />
                    <SolidColorBrush x:Key="CockpitHover" Color="#1C2128" />
                    <SolidColorBrush x:Key="CockpitSelected" Color="#1E2D47" />
                    <SolidColorBrush x:Key="CockpitInk" Color="#E5E9EE" />
                    <SolidColorBrush x:Key="CockpitMuted" Color="#9AA4B0" />
                    <SolidColorBrush x:Key="CockpitLine" Color="#333A44" />
                    <SolidColorBrush x:Key="CockpitAccent" Color="#6E9EF5" />
                    <SolidColorBrush x:Key="CockpitWarning" Color="#33D98E04" />
                    <SolidColorBrush x:Key="CockpitWarningLine" Color="#E0A33A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- El acento de Fluent (botones de acción, checkboxes, foco) es el mismo azul que los nodos. -->
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#2F6FDE" RegionColor="#F3F5F8" />
                <ColorPaletteResources x:Key="Dark" Accent="#3F7BE6" RegionColor="#16191E" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <!-- ===== Menú lateral ===== -->
        <Style Selector="ListBox.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem, Button.nav-button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem /template/ ContentPresenter, Button.nav-button /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter, Button.nav-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CockpitHover}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter, Button.nav-button.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CockpitSelected}" />
        </Style>

        <!-- Barrita de color a la izquierda del ítem activo. -->
        <Style Selector="Border.marker">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected Border.marker, Button.nav-button.active Border.marker">
            <Setter Property="Background" Value="{DynamicResource CockpitAccent}" />
        </Style>

        <Style Selector="Path.nav-icon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stroke" Value="{DynamicResource CockpitMuted}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected Path.nav-icon, Button.nav-button.active Path.nav-icon">
            <Setter Property="Stroke" Value="{DynamicResource CockpitAccent}" />
        </Style>

        <Style Selector="TextBlock.nav-text">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource CockpitMuted}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected TextBlock.nav-text, Button.nav-button.active TextBlock.nav-text">
            <Setter Property="Foreground" Value="{DynamicResource CockpitInk}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.nav-section">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource CockpitMuted}" />
        </Style>

        <!-- ===== Encabezado de página ===== -->
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource CockpitInk}" />
        </Style>
        <Style Selector="TextBlock.page-sub">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource CockpitMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- ===== Contenido ===== -->
        <!-- Texto de los resúmenes: letra proporcional, más grande y con aire entre líneas. -->
        <Style Selector="TextBox.report">
            <Setter Property="FontFamily" Value="Segoe UI,Inter,sans-serif" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="LineHeight" Value="24" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <!-- El resumen es el protagonista: superficie propia, no el gris del fondo (en reposo, hover y foco). -->
        <Style Selector="TextBox.report /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource CockpitSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CockpitLine}" />
        </Style>
        <Style Selector="TextBox.report:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource CockpitSurface}" />
        </Style>
        <Style Selector="TextBox.report:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource CockpitSurface}" />
        </Style>

        <!-- Vista de lectura del resumen: una hoja con jerarquía, no una consola. -->
        <Style Selector="Border.sheet">
            <Setter Property="Background" Value="{DynamicResource CockpitSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CockpitLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="TextBlock.sheet-empty">
            <Setter Property="Margin" Value="26,22" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource CockpitMuted}" />
        </Style>
        <Style Selector="TextBlock.r-heading">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource CockpitInk}" />
        </Style>
        <Style Selector="TextBlock.r-meta">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource CockpitMuted}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="TextBlock.r-body">
            <Setter Property="FontFamily" Value="Segoe UI,Inter,sans-serif" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="LineHeight" Value="23" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource CockpitInk}" />
        </Style>
        <Style Selector="Ellipse.r-dot">
            <Setter Property="Width" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="Fill" Value="{DynamicResource CockpitMuted}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="8,9,0,0" />
        </Style>
        <!-- Etiqueta del repo: se lee de un vistazo a qué proyecto pertenece cada línea. -->
        <Style Selector="Border.r-repo">
            <Setter Property="Background" Value="{DynamicResource CockpitSelected}" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7,1,7,2" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Border.r-repo > TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource CockpitAccent}" />
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource CockpitMuted}" />
        </Style>

        <!-- Secciones de Configuración. -->
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource CockpitInk}" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <!-- Filas de notas y logros: separadas por una línea fina, sin tarjetas. -->
        <Style Selector="ListBox.rows">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.rows ListBoxItem">
            <Setter Property="Padding" Value="4,12" />
            <Setter Property="BorderBrush" Value="{DynamicResource CockpitLine}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <!-- Aviso: borde izquierdo de color, como una nota al margen de la bitácora. -->
        <Style Selector="Border.warning">
            <Setter Property="Background" Value="{DynamicResource CockpitWarning}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CockpitWarningLine}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="CornerRadius" Value="0,6,6,0" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
    </Application.Styles>
</Application>
