<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevCockpit.App.ViewModels"
             x:Class="DevCockpit.App.Views.NotesView"
             x:DataType="vm:NotesViewModel"
             x:Name="Root">
    <DockPanel>
        <ListBox ItemsSource="{Binding Items}" Classes="rows">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:NoteRow">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Borrar"
                                Command="{Binding #Root.((vm:NotesViewModel)DataContext).DeleteCommand}"
                                CommandParameter="{Binding}" />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding When}" Width="120" Classes="muted" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left" Text="★" IsVisible="{Binding IsAchievement}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
