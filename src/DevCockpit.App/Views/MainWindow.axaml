<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DevCockpit.App.ViewModels"
        xmlns:views="using:DevCockpit.App.Views"
        x:Class="DevCockpit.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Title}"
        Width="1000" Height="660" MinWidth="720" MinHeight="460"
        Background="{DynamicResource CockpitWindow}"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="210,*">

        <!-- Menú lateral: marca arriba, páginas de la bitácora y Configuración abajo. -->
        <Border Grid.Column="0" Background="{DynamicResource CockpitRail}"
                BorderBrush="{DynamicResource CockpitLine}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,18,12,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="8,0,0,26">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource CockpitAccent}">
                        <TextBlock Text="›_" Foreground="White" FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                    </Border>
                    <TextBlock Text="dev-cockpit" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource CockpitInk}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Spacing="10">
                    <Button Classes="nav-button" Classes.active="{Binding IsSettingsOpen}"
                            Command="{Binding OpenSettingsCommand}">
                        <Grid ColumnDefinitions="3,30,*" Height="38">
                            <Border Classes="marker" />
                            <Path Grid.Column="1" Classes="nav-icon"
                                  Data="{Binding SettingsPage.Icon, Converter={x:Static views:Icons.ToGeometry}}" />
                            <TextBlock Grid.Column="2" Classes="nav-text" Text="{Binding SettingsPage.Title}" />
                        </Grid>
                    </Button>
                    <TextBlock Classes="muted" FontSize="12" Margin="12,0" TextWrapping="Wrap"
                               Text="Ctrl+Alt+N anota desde cualquier app." />
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Classes="nav-section" Text="Bitácora" Margin="12,0,0,6" />

                <ListBox Classes="nav" ItemsSource="{Binding LogPages}" SelectedItem="{Binding SelectedLogPage}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavPage">
                            <Grid ColumnDefinitions="3,30,*" Height="38">
                                <Border Classes="marker" />
                                <Path Grid.Column="1" Classes="nav-icon"
                                      Data="{Binding Icon, Converter={x:Static views:Icons.ToGeometry}}" />
                                <TextBlock Grid.Column="2" Classes="nav-text" Text="{Binding Title}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Página actual: título, para qué sirve y su contenido (el ViewLocator elige la vista). -->
        <DockPanel Grid.Column="1" Margin="36,26,36,24">
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,18">
                <TextBlock Classes="page-title" Text="{Binding CurrentPage.Title}" />
                <TextBlock Classes="page-sub" Text="{Binding CurrentPage.Description}" />
            </StackPanel>
            <ContentControl Content="{Binding CurrentPage.Content}" />
        </DockPanel>
    </Grid>

</Window>
