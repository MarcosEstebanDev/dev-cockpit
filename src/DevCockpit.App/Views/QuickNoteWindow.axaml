<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DevCockpit.App.ViewModels"
        x:Class="DevCockpit.App.Views.QuickNoteWindow"
        x:DataType="vm:QuickNoteViewModel"
        Title="Nota rápida"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="False" CanResize="False"
        WindowDecorations="BorderOnly">
    <Border Padding="14" BorderThickness="1" BorderBrush="#40808080">
        <StackPanel Spacing="10">
            <TextBlock Text="Nota rápida · Enter guarda · Shift+Enter salto de línea · Esc cierra"
                       Opacity="0.6" FontSize="12" />
            <TextBox x:Name="NoteText" Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="56" FontSize="15" PlaceholderText="¿Qué hiciste?" />
            <TextBlock Text="{Binding Error}" Foreground="#C0392B" TextWrapping="Wrap"
                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <CheckBox Content="Es un logro" IsChecked="{Binding IsAchievement}" />
                <TextBox Text="{Binding Metric}" PlaceholderText="Número (ej: de 4 s a 300 ms)" Width="280"
                         IsVisible="{Binding IsAchievement}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
